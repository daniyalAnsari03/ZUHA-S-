# ---------------------------------------------------------------------------
# DINS by Daniyal — AI E-Commerce Website
# Environment variables.
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any real secrets.
# ---------------------------------------------------------------------------

# --- Supabase (public, safe for the browser) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Either the new-style publishable key (sb_publishable_...) OR the legacy anon
# key. The app reads NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY first, then falls
# back to NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase (server-only, MUST NEVER reach the browser) ------------------
# Service-role key bypasses RLS. Only usable in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OAuth (optional, server-only) -----------------------------------------
# Google OAuth credentials, configured in the Supabase dashboard.
# NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:3000

# --- Payments (Phase 4 checkout foundation) --------------------------------
# Provider abstraction introduced in Phase 4. Leave unset (or set to "none")
# and checkout surfaces a safe "not configured yet" state — it never fakes
# payment success. Set to "cod" for the Cash on Delivery flow or "card" (with
# PAYMENT_PROVIDER_CARD_ENABLED=true) once a Pakistan-focused provider is wired
# in a later phase.
# PAYMENT_PROVIDER=none
# PAYMENT_PROVIDER_CARD_ENABLED=false
#
# --- Email reports (Phase 8 — Resend) --------------------------------------
# Resend API key (server-only) for the automated daily/weekly business report
# emails. NEVER expose this key to the browser.
# RESEND_API_KEY=re_xxxxxxxx
# From address shown on report emails (must be a verified sender in Resend).
# EMAIL_REPORT_FROM="DINS by Daniyal <reports@yourdomain.com>"
# Secret that authorizes the Vercel CRON report endpoint. Set a long random
# value (e.g. openssl rand -hex 32). Required for cron-keyed invocations; the
# Vercel scheduler also authenticates via its own signed header.
# CRON_SECRET=

# Future phases (do not fill until implemented) -------------------------------
# AI provider
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# Payments (provider secrets, filled only when a concrete provider is added)
# PAYMENT_PROVIDER_SECRET=
#
# Monitoring / observability
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# DINS by Daniyal — QA test environment (schema reference)
#
# Copy this file to `.env.test` and fill in the real values.
# `.env.test` is gitignored and MUST NEVER be committed or pushed.
# Credentials must not be hardcoded in tests/qa/*.mjs; those scripts read them
# from the environment via `tests/qa/load-env.mjs`.
# ---------------------------------------------------------------------------

# --- Supabase project --------------------------------------------------------
# The project URL/ref is public config. The SERVICE keys below are SECRETS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI / AI model -------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5.6-luna

# --- WhatsApp Cloud API (Phase 8) ---------------------------------------------
# Real values are NOT required for unit tests (they mock fetch), but the
# variables are listed here as the schema reference.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_API_VERSION=v21.0

# --- App under test ----------------------------------------------------------
APP_URL=http://localhost:3000

# --- QA users (non-production test accounts) ---------------------------------
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password
CUSTOMER_EMAIL=qa.customer@dins.test
CUSTOMER_PASSWORD=your-qa-customer-password